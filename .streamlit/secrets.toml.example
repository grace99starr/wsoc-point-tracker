# Copy this file to .streamlit/secrets.toml for local development and fill
# in real values. secrets.toml itself is gitignored — never commit it.
#
# On Streamlit Community Cloud, paste the same two keys into your app's
# Settings -> Secrets box instead of uploading a file.

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"
